import KEBall.DirichletAngularEstimate
import Mathlib.Analysis.InnerProductSpace.Adjoint
import Mathlib.Analysis.SpecialFunctions.Exponential

/-! Tangential difference quotients generated by skew-adjoint linear maps. -/

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false

open Filter MeasureTheory Set
open scoped NNReal

namespace KEBall

local notation "ν[" n "]" => Measure.restrict (volume0 n) (unitBall n)

private theorem orthogonalFlow_unitary {n : ℕ} (S : E n →L[ℝ] E n) (hS : star S = -S) (t : ℝ) :
    NormedSpace.exp (t • S) ∈ unitary (E n →L[ℝ] E n) := by
  let : NormedAlgebra ℚ (E n →L[ℝ] E n) :=
    NormedAlgebra.restrictScalars ℚ ℝ (E n →L[ℝ] E n)
  apply NormedSpace.exp_mem_unitary_of_mem_skewAdjoint
  rw [skewAdjoint.mem_iff, star_smul, star_trivial, hS, smul_neg]

/-- The orthogonal one-parameter flow of a skew-adjoint real linear field. -/
noncomputable def orthogonalFlow {n : ℕ} (S : E n →L[ℝ] E n) (hS : star S = -S) (t : ℝ) :
    E n ≃ₗᵢ[ℝ] E n :=
  Unitary.linearIsometryEquiv ⟨NormedSpace.exp (t • S), orthogonalFlow_unitary S hS t⟩

theorem orthogonalFlow_CLM {n : ℕ} (S : E n →L[ℝ] E n) (hS : star S = -S) (t : ℝ) :
    (orthogonalFlow S hS t).toContinuousLinearEquiv.toContinuousLinearMap =
      NormedSpace.exp (t • S) := rfl

/-- Operator norm control of the rotation increment by the flow parameter. -/
theorem norm_orthogonalFlow_sub_id_le {n : ℕ} (S : E n →L[ℝ] E n) (hS : star S = -S) (t : ℝ) :
    ‖(orthogonalFlow S hS t).toContinuousLinearEquiv.toContinuousLinearMap -
      ContinuousLinearMap.id ℝ (E n)‖ ≤ ‖S‖ * |t| := by
  let f (s : ℝ) := NormedSpace.exp (s • S)
  have hF (s : ℝ) : HasDerivAt f (NormedSpace.exp (s • S) * S) s :=
    hasDerivAt_exp_smul_const S s
  have hBound (s : ℝ) : ‖fderiv ℝ f s‖ ≤ ‖S‖ := by
    rw [(hF s).hasFDerivAt.fderiv]
    apply ContinuousLinearMap.opNorm_le_bound _ (norm_nonneg _)
    intro y
    change ‖y • (NormedSpace.exp (s • S) * S)‖ ≤ ‖S‖ * ‖y‖
    rw [norm_smul, mul_comm ‖S‖]
    apply mul_le_mul_of_nonneg_left _ (norm_nonneg _)
    have hNorm : ‖NormedSpace.exp (s • S)‖ ≤ 1 := by
      rw [← orthogonalFlow_CLM S hS s]
      apply ContinuousLinearMap.opNorm_le_bound _ (by norm_num)
      intro x
      change ‖orthogonalFlow S hS s x‖ ≤ 1 * ‖x‖
      rw [one_mul, LinearIsometryEquiv.norm_map]
    exact (norm_mul_le _ _).trans (mul_le_of_le_one_left (norm_nonneg _) hNorm)
  have h := Convex.norm_image_sub_le_of_norm_fderiv_le (𝕜 := ℝ) (s := Set.univ)
    (fun s _ => (hF s).differentiableAt) (fun s _ => hBound s) convex_univ
    (Set.mem_univ (0 : ℝ)) (Set.mem_univ t)
  rw [orthogonalFlow_CLM S hS t]
  have hZero : f 0 = (1 : E n →L[ℝ] E n) := by
    change NormedSpace.exp ((0 : ℝ) • S) = _
    exact (congrArg (fun X : E n →L[ℝ] E n => NormedSpace.exp X) (zero_smul ℝ S)).trans
      NormedSpace.exp_zero
  rw [hZero, sub_zero, Real.norm_eq_abs] at h
  exact h

/-- The gradient norms of tangential difference quotients stay bounded
as the angular parameter tends to zero. -/
theorem norm_dirichletGradient_angular_differenceQuotient_le {n : ℕ} (hn : 0 < n)
    {A : E n → E n →L[ℝ] E n} (hA : MemLp A ⊤ ν[n])
    {l : ℝ} (hE : ∀ᵐ x ∂ν[n], ∀ v : E n, l * ‖v‖ ^ 2 ≤ inner ℝ (A x v) v)
    {K L : ℝ≥0} (hLipA : LipschitzOnWith K A (closedUnitBall n))
    {M : ℝ} (hM₀ : 0 ≤ M) (hM : ∀ x ∈ closedUnitBall n, ‖A x‖ ≤ M)
    {g : DirichletBallL2 n ℝ} {G : E n → ℝ} (hRep : g =ᵐ[ν[n]] G)
    (hLipG : LipschitzOnWith L G (closedUnitBall n))
    {u : DirichletSobolev n} (hu : IsDirichletWeakSolution A g u)
    (S : E n →L[ℝ] E n) (hS : star S = -S) {t : ℝ} (ht : t ≠ 0) :
    l * ‖((t⁻¹ • (dirichletSobolevPullback (orthogonalFlow S hS t) u - u) :
      DirichletSobolev n) : DirichletBallL2Pair n).snd‖ ≤
      ((L : ℝ) / n + ((K : ℝ) + 2 * M) * ‖(u : DirichletBallL2Pair n).snd‖) * ‖S‖ := by
  let R := orthogonalFlow S hS t
  let v := dirichletSobolevPullback R u - u
  let C := (L : ℝ) / n + ((K : ℝ) + 2 * M) * ‖(u : DirichletBallL2Pair n).snd‖
  have hC : 0 ≤ C := by dsimp [C]; positivity
  have h := norm_dirichletGradient_angular_increment_le hn hA hE hLipA hM₀ hM hRep hLipG hu R
  have hInc : l * ‖(v : DirichletBallL2Pair n).snd‖ ≤ C * (‖S‖ * |t|) :=
    h.trans (mul_le_mul_of_nonneg_left (norm_orthogonalFlow_sub_id_le S hS t) hC)
  change l * ‖t⁻¹ • (v : DirichletBallL2Pair n).snd‖ ≤ C * ‖S‖
  rw [norm_smul, Real.norm_eq_abs, abs_inv]
  calc
    _ = |t|⁻¹ * (l * ‖(v : DirichletBallL2Pair n).snd‖) := by ring
    _ ≤ |t|⁻¹ * (C * (‖S‖ * |t|)) := mul_le_mul_of_nonneg_left hInc (by positivity)
    _ = _ := by field_simp [abs_ne_zero.mpr ht]

theorem orthogonalFlow_zero_apply {n : ℕ} (S : E n →L[ℝ] E n) (hS : star S = -S)
    (x : E n) : orthogonalFlow S hS 0 x = x := by
  have hExp : NormedSpace.exp ((0 : ℝ) • S) = (1 : E n →L[ℝ] E n) :=
    (congrArg (fun T : E n →L[ℝ] E n => NormedSpace.exp T) (zero_smul ℝ S)).trans NormedSpace.exp_zero
  change (NormedSpace.exp ((0 : ℝ) • S)) x = x
  rw [hExp]
  rfl

theorem orthogonalFlow_symm_eq_neg {n : ℕ} (S : E n →L[ℝ] E n) (hS : star S = -S)
    (t : ℝ) : (orthogonalFlow S hS t).symm = orthogonalFlow S hS (-t) := by
  apply LinearIsometryEquiv.ext
  intro x
  change (star (NormedSpace.exp (t • S))) x = (NormedSpace.exp ((-t) • S)) x
  rw [NormedSpace.star_exp]
  have he : star (t • S) = (-t) • S := by
    rw [star_smul, star_trivial, hS, smul_neg]
    exact (neg_smul t S).symm
  rw [he]

theorem hasDerivAt_orthogonalFlow_apply_zero {n : ℕ} (S : E n →L[ℝ] E n)
    (hS : star S = -S) (x : E n) :
    HasDerivAt (fun s => orthogonalFlow S hS s x) (S x) 0 := by
  have hD := hasDerivAt_exp_smul_const S (0 : ℝ)
  have hExp : NormedSpace.exp ((0 : ℝ) • S) = (1 : E n →L[ℝ] E n) :=
    (congrArg (fun T : E n →L[ℝ] E n => NormedSpace.exp T) (zero_smul ℝ S)).trans NormedSpace.exp_zero
  rw [hExp, one_mul] at hD
  exact (ContinuousLinearMap.apply ℝ (E n) x).hasFDerivAt.comp_hasDerivAt 0 hD

theorem hasDerivAt_test_orthogonalFlow_zero {n : ℕ} (S : E n →L[ℝ] E n)
    (hS : star S = -S) {ψ : E n → ℝ} {x : E n} (hψ : DifferentiableAt ℝ ψ x) :
    HasDerivAt (fun t => ψ (orthogonalFlow S hS t x)) (fderiv ℝ ψ x (S x)) 0 := by
  have h := hasDerivAt_orthogonalFlow_apply_zero S hS x
  have hF : HasFDerivAt ψ (fderiv ℝ ψ x) (orthogonalFlow S hS 0 x) := by
    rw [orthogonalFlow_zero_apply]
    exact hψ.hasFDerivAt
  exact hF.comp_hasDerivAt 0 h

end KEBall
