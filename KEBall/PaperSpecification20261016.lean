import KEBall.Specification
import Drafts.KEBall.DOneNormalized
import Drafts.KEBall.FixedMetricHessian
import Drafts.KEBall.ExteriorRecovery

/-!
# Acceptance specifications for KE_Ball_Symmetry_20261016.tex

The frozen v4 specifications are imported without modification.  This file
states the additional interfaces needed by the 2026-10-16 manuscript.
In particular, mean-field solutions are defined by the full exterior-algebra
equation, and their converse scaling parameter is defined from the actual
positive top-form measure.  No radiality, mass or integrability premise is
added.  These definitions are propositions, not proof receipts.
-/

set_option autoImplicit false
open Set MeasureTheory
open scoped ContDiff BigOperators ComplexOrder

namespace KEBall.Paper20261016

def IsRadialOnClosedBall {n : ℕ} (u : E n → ℝ) : Prop :=
  ∀ x ∈ closedUnitBall n, ∀ y ∈ closedUnitBall n, ‖x‖ = ‖y‖ → u x = u y

def RadialSymmetryStatement : Prop :=
  ∀ (n : ℕ), 2 ≤ n → ∀ (μ : ℝ) (u : E n → ℝ),
    IsSolution n μ u → IsRadialOnClosedBall u

def IsMeanFieldSolution (n : ℕ) (γ : ℝ) (φ : E n → ℝ) : Prop :=
  0 < γ ∧ SmoothNear (closedUnitBall n) φ ∧
  (∀ x ∈ unitBall n, (complexHessian φ x).PosDef) ∧
  (∀ x ∈ unitSphere n, φ x = 0) ∧
  (∀ x ∈ unitBall n, d0Exterior φ x ^ n =
    ((Real.exp (-γ * φ x) / normalizingIntegral γ φ : ℝ) : ℂ) •
      normalizedExteriorVolume n)

def meanFieldSolutionSet (n : ℕ) (γ : ℝ) : Set (ClosedBall n → ℝ) :=
  {v | ∃ φ : E n → ℝ, IsMeanFieldSolution n γ φ ∧ restrictClosedBall φ = v}

/-- Corollary 1.2, with the full D0 top-form equation and all smooth solutions. -/
def MeanFieldClassificationStatement : Prop :=
  ∀ (n : ℕ), 2 ≤ n → ∀ γ : ℝ, 0 < γ →
    (γ < (n + 1 : ℝ) →
      IsMeanFieldSolution n γ (normalizedPotential n γ) ∧
      meanFieldSolutionSet n γ = {restrictClosedBall (normalizedPotential n γ)}) ∧
    ((n + 1 : ℝ) ≤ γ → meanFieldSolutionSet n γ = ∅)

/-- Literal Euclidean integral of the actual positive D0 top form on the ball.
Finiteness and positivity for solutions are proved, not assumed. -/
noncomputable def mongeAmpereMass (n : ℕ) (u : E n → ℝ) : ℝ :=
  ((d0TopMeasure u) (unitBall n)).toReal

noncomputable def massCoupling (n : ℕ) (u : E n → ℝ) : ℝ :=
  mongeAmpereMass n u ^ (1 / (n : ℝ))

/-- Introductory normalization correspondence, including its stated mass
root and preservation of radial symmetry in both directions. -/
def NormalizationCorrespondenceStatement : Prop :=
  (∀ (n : ℕ), 2 ≤ n → ∀ (γ : ℝ) (φ : E n → ℝ),
    IsMeanFieldSolution n γ φ →
      IsSolution n (γ ^ n / normalizingIntegral γ φ) (fun x => γ * φ x) ∧
      mongeAmpereMass n φ = 1 ∧
      mongeAmpereMass n (fun x => γ * φ x) = γ ^ n ∧
      (IsRadialOnClosedBall (fun x => γ * φ x) ↔ IsRadialOnClosedBall φ)) ∧
  (∀ (n : ℕ), 2 ≤ n → ∀ (μ : ℝ) (u : E n → ℝ),
    IsSolution n μ u →
      0 < massCoupling n u ∧ massCoupling n u < (n + 1 : ℝ) ∧
      IsMeanFieldSolution n (massCoupling n u) (fun x => u x / massCoupling n u) ∧
      (IsRadialOnClosedBall (fun x => u x / massCoupling n u) ↔
        IsRadialOnClosedBall u))

/-- D0 is identified with the exterior derivative of the actual one-form;
its top power has the stated orientation and volume normalization. -/
def ExteriorConventionStatement : Prop :=
  (∀ n : ℕ,
    exteriorTopMeasure (fun _ : E n => normalizedExteriorVolume n) = volume0 n) ∧
  (∀ (n : ℕ) (u : E n → ℝ) (x : E n),
    d0Exterior u x ^ n = (complexHessian u x).det • normalizedExteriorVolume n) ∧
  (∀ (n : ℕ) (μ : ℝ) (u : E n → ℝ), IsSolution n μ u →
    ∀ x ∈ closedUnitBall n, ∀ v w : E n,
      exteriorEvaluation ![v, w] (d0Exterior u x) =
        ((fderiv ℝ (fun y => dcZeroForm u y w) x v -
          fderiv ℝ (fun y => dcZeroForm u y v) x w : ℝ) : ℂ)) ∧
  (∀ (n : ℕ) (u : E n → ℝ) (x : E n), ContDiffAt ℝ ∞ u x →
    d1Exterior (fun y => u y / 2) x = d0Exterior u x)

/-- A single actual local metric and its Levi-Civita connection realize
the Ricci, arbitrary-test Hessian and gradient conventions simultaneously. -/
def MetricConventionStatement : Prop :=
  ∀ (n : ℕ) (μ : ℝ) (u : E n → ℝ), IsSolution n μ u →
    ∀ p ∈ unitBall n,
    ∃ (g : PoincareMT.RiemannianMetric (2 * n) (E n))
      (D : PoincareMT.LeviCivitaData g) (U : Set (E n)),
      IsOpen U ∧ p ∈ U ∧ U ⊆ unitBall n ∧
      (∀ x ∈ U, ∀ v w : E n, g.inner x v w = realMetricForm u x v w) ∧
      (∀ x ∈ U, ∀ v w : E n, D.ricci x v w = g.inner x v w) ∧
      (∀ x ∈ U, ∀ h : E n → ℝ, ContDiffAt ℝ ∞ h x →
        (∀ i j : Fin n, metricCovariantHessian20 u h x i j =
          complexify20 (D.hessian h x) i j) ∧
        (∀ i : Fin n, complexCoord (D.gradient h x) i =
          ∑ j : Fin n, inverseCoefficient u x i j *
            partialBar j (fun y => (h y : ℂ)) x))

/-- The equality case is the (2,0) Hessian of exp(-u/(n+1)) in g_u,
not the full real Hessian and not a new metric generated by that function. -/
def ExponentialGeometricRigidityStatement : Prop :=
  ∀ (n : ℕ), 2 ≤ n → ∀ (μ : ℝ) (u : E n → ℝ), IsSolution n μ u →
    ∀ p ∈ unitBall n,
    ∃ (t : ℝ) (g : PoincareMT.RiemannianMetric (2 * n) (E n))
      (D : PoincareMT.LeviCivitaData g) (U : Set (E n)),
      0 < t ∧ t < (n + 1 : ℝ) ∧ boundaryPolynomial n t = μ ∧
      IsOpen U ∧ p ∈ U ∧ U ⊆ unitBall n ∧
      (∀ x ∈ U, ∀ v w : E n, g.inner x v w = realMetricForm u x v w) ∧
      (∀ x ∈ U, ∀ i j : Fin n, complexify20 (D.hessian (expWeight u) x) i j = 0) ∧
      (∀ x ∈ U, D.gradient (expWeight u) x = (-1 / ((n + 1 : ℝ) - t)) • x)

/-- Precisely enumerated mathematical scope; this does not certify literature
claims, bibliographic priority, or literal identity of the two proof routes. -/
def CurrentPaperStatement : Prop :=
  RadialExistenceStatement ∧ LowerSlopeStatement ∧ BoundaryIdentitiesStatement ∧
  LogarithmicFluxStatement ∧ ClassificationStatement ∧ SolutionCountsStatement ∧
  NormalizedClassificationStatement ∧ RadialSymmetryStatement ∧
  MeanFieldClassificationStatement ∧ NormalizationCorrespondenceStatement ∧
  ExteriorConventionStatement ∧ MetricConventionStatement ∧
  ExponentialGeometricRigidityStatement ∧ D1NormalizedClassificationStatement

end KEBall.Paper20261016
